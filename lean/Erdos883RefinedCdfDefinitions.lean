import Lean
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Erdos883Verified

/-- Exact state head density, asymptotic mass, and finite-count discrepancy. -/
def refinedCdfStates : List (Rat × Rat × Rat) :=
  ([3, 5, 7, 11] : List Nat).foldl (fun (acc : List (Rat × Rat × Rat)) (p : Nat) =>
    acc.flatMap (fun aqe =>
      [(aqe.1, aqe.2.1 * ((p : Rat) - 1) / (p : Rat), 2 * aqe.2.2),
       (aqe.1 * ((p : Rat) - 1) / (p : Rat), aqe.2.1 / (p : Rat), aqe.2.2)])) [(1, 1, 1/2)]

def refinedCdfState (aqe : Rat × Rat × Rat) (t : Rat) : Rat :=
  let cap := aqe.2.1 + 2 * aqe.2.2 / 200000
  let num := aqe.2.1 * (47 / 2000) + aqe.2.2 * (991 / 100) / 200000
  if aqe.1 ≤ t then cap else min cap (num * (aqe.1 + t) / (2 * (aqe.1 - t)))

def refinedCdfBound (t : Rat) : Rat :=
  min (22 * t^6) ((refinedCdfStates.map (fun aqe => refinedCdfState aqe t)).foldl (· + ·) 0)

def refinedHighCell (i : Nat) : Prop :=
  (9 : Rat) / 10 * (1 / 3 + (i : Rat) / 2400) - 1 / 6 -
    refinedCdfBound (1 / 3 + ((i + 1 : Nat) : Rat) / 2400) > 11 / 500

